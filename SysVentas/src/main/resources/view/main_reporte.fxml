<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: #f7f7f7;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sysventas.controller.ReporteController">

    <children>

        <VBox spacing="12"
              alignment="TOP_CENTER"
              AnchorPane.topAnchor="10"
              AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10"
              AnchorPane.bottomAnchor="10">

            <!-- ======================================================
                 PANEL SUPERIOR (Título + Filtros)
            ====================================================== -->
            <VBox spacing="8"
                  alignment="CENTER"
                  maxWidth="600"
                  style="-fx-background-color: white; -fx-padding: 15;
                         -fx-background-radius: 8;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 7, 0, 0, 2);">

                <Label text="Reporte de Ventas"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;"
                       alignment="CENTER"
                       maxWidth="Infinity"/>

                <Separator/>

                <GridPane hgap="15" vgap="12" alignment="CENTER">

                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" minWidth="100"/>
                        <ColumnConstraints halignment="CENTER" minWidth="150"/>
                        <ColumnConstraints halignment="CENTER" minWidth="100"/>
                        <ColumnConstraints halignment="CENTER" minWidth="150"/>
                        <ColumnConstraints halignment="CENTER" minWidth="150"/>
                    </columnConstraints>

                    <!-- Fecha Inicio -->
                    <Label text="Fecha Inicio" GridPane.rowIndex="0" GridPane.columnIndex="0"/>

                    <DatePicker fx:id="txtFechaI"
                                prefWidth="160"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="1"/>

                    <!-- Fecha Fin -->
                    <Label text="Fecha Fin" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

                    <DatePicker fx:id="txtFechaF"
                                prefWidth="160"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="3"/>

                    <!-- Botón -->
                    <Button text="Generar Reporte"
                            onAction="#generarReporte"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="4"
                            style="-fx-background-color: #0277BD; -fx-text-fill: white;
                                   -fx-padding: 6 14; -fx-background-radius: 6;
                                   -fx-font-weight: bold;"/>

                </GridPane>

            </VBox>

            <!-- ======================================================
                 PANEL PARA MOSTRAR LOS REPORTES
            ====================================================== -->
            <AnchorPane style="-fx-background-color: white;
                                -fx-background-radius: 8;
                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 6, 0, 0, 2);"
                        maxWidth="900">

                <StackPane fx:id="paneRepo"
                           AnchorPane.topAnchor="10"
                           AnchorPane.leftAnchor="10"
                           AnchorPane.rightAnchor="10"
                           AnchorPane.bottomAnchor="10"
                           style="-fx-border-color: #e0e0e0; -fx-border-radius: 8;">
                </StackPane>

            </AnchorPane>

        </VBox>

    </children>

    <padding>
        <Insets top="5" left="5" right="5" bottom="5"/>
    </padding>

</AnchorPane>
