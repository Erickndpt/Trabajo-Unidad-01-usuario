<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" stylesheets="@/css/estilos.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.sysventas.controller.UsuarioController">

    <children>

        <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <!-- ======================================================
                 SECCIÓN SUPERIOR: TÍTULO + BUSCADOR
            ====================================================== -->
            <AnchorPane styleClass="panel-top">
                <children>

                    <Label layoutX="14" layoutY="12" text="Gestión de Usuarios">
                        <font><Font name="System Bold" size="20"/></font>
                    </Label>

                    <Label layoutX="332" layoutY="48" text="Buscar Usuario"/>
                    <TextField fx:id="txtFiltroDato" layoutX="332" layoutY="68"
                               prefHeight="28" prefWidth="200"/>

                    <Button layoutX="540" layoutY="67"
                            mnemonicParsing="false"
                            styleClass="btnBuscar"
                            text="Buscar"/>
                </children>
            </AnchorPane>

            <!-- ======================================================
                 SECCIÓN DEL FORMULARIO
            ====================================================== -->
            <AnchorPane styleClass="panel-form">
                <children>

                    <GridPane hgap="5" vgap="5">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10"/>
                        </padding>

                        <columnConstraints>
                            <ColumnConstraints prefWidth="120"/>
                            <ColumnConstraints prefWidth="180"/>
                            <ColumnConstraints prefWidth="120"/>
                            <ColumnConstraints prefWidth="180"/>
                        </columnConstraints>

                        <children>

                            <!-- Título -->
                            <Label text="Registro de Usuario"
                                   GridPane.columnSpan="4"
                                   GridPane.halignment="CENTER">
                                <font><Font name="System Bold" size="14"/></font>
                            </Label>

                            <!-- Usuario -->
                            <Label text="Usuario" GridPane.rowIndex="1"/>
                            <TextField fx:id="txtUser"
                                       GridPane.columnIndex="1"
                                       GridPane.columnSpan="3"
                                       GridPane.rowIndex="1"/>

                            <!-- Clave -->
                            <Label text="Clave" GridPane.rowIndex="2"/>
                            <PasswordField fx:id="txtClave"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="2"/>

                            <!-- Perfil -->
                            <Label text="Perfil"
                                   GridPane.columnIndex="2"
                                   GridPane.rowIndex="2"/>
                            <ComboBox fx:id="cbxPerfil"
                                      prefHeight="26"
                                      prefWidth="150"
                                      GridPane.columnIndex="3"
                                      GridPane.rowIndex="2"/>

                            <!-- Botones -->
                            <Button text="Guardar"
                                    onAction="#validarFormulario"
                                    styleClass="btnGuardar"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="5"/>

                            <Button text="Limpiar/Nuevo"
                                    onAction="#clearForm"
                                    styleClass="btnCancelar"
                                    GridPane.columnIndex="3"
                                    GridPane.rowIndex="5"/>

                            <!-- Mensaje -->
                            <Label fx:id="lbnMsg"
                                   style="-fx-text-fill: #444;"
                                   GridPane.columnSpan="4"
                                   GridPane.rowIndex="6"/>

                        </children>

                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>

                    </GridPane>

                </children>
            </AnchorPane>

            <!-- ======================================================
                 TABLA ABAJO
            ====================================================== -->
            <AnchorPane styleClass="panel-table">
                <children>
                    <TableView fx:id="tableView"
                               prefHeight="300"
                               AnchorPane.bottomAnchor="5"
                               AnchorPane.leftAnchor="5"
                               AnchorPane.rightAnchor="5"
                               AnchorPane.topAnchor="5"/>
                </children>
            </AnchorPane>

        </VBox>

    </children>

    <padding>
        <Insets bottom="10" left="10" right="10" top="10"/>
    </padding>

</AnchorPane>



